    window_menus.add_argument('--emit-cmd', action='store_true',
                              help='print the command instead of running it')

    remote_session_copying = commands.add_parser(
        'session-remote-copy', help='print and copy the command that opens a remote session')
    remote_session_copying.add_argument('server', help='SSH config alias or user@host')
    remote_session_copying.add_argument('session', help='session id on the remote host')
    remote_session_copying.add_argument('--harness', choices=SESSION_HARNESSES,
                                        default='pi', help='store to read (default: %(default)s)')
    remote_session_copying.add_argument('--cwd', default='',
                                        help='remote project directory to start in')

    remote_session_deleting = commands.add_parser(
        'session-remote-delete', help="delete one of a remote host's transcripts")
    remote_session_deleting.add_argument('server', help='SSH config alias or user@host')
    remote_session_deleting.add_argument('session', help='session id on the remote host')
    remote_session_deleting.add_argument('--harness', choices=SESSION_HARNESSES,
                                         default='pi', help='store to read (default: %(default)s)')
    remote_session_deleting.add_argument('--force', action='store_true',
                                         help='delete even when a pi process is running it there')

    remote_session_pruning = commands.add_parser(
        'session-remote-prune', help="delete a remote host's old sessions and zmx sessions")
    remote_session_pruning.add_argument('server', help='SSH config alias or user@host')
    remote_session_pruning.add_argument('--older-than', required=True, metavar='AGE',
                                        help='an age such as 1d, 3h, 10m, or 1d3h10m')
    # A store name, a comma-separated set, or all: the host is read the way this picker reads
    # it, so one prune covers every store the picker shows.
    remote_session_pruning.add_argument('--harness', default='all',
                                        help='stores to read: one, a set, or all '
                                             '(default: %(default)s)')
    remote_session_pruning.add_argument('--zmx', action='store_true',
                                        help="also end that host's own old zmx sessions")
    remote_session_pruning.add_argument('--yes', action='store_true',
                                        help='delete; without it the selection is only reported')
    remote_session_pruning.add_argument('--force', action='store_true',
                                        help='also delete a session its pi process still writes')

    remote_harnesses = commands.add_parser(
        'harnesses-remote', help='report which session stores a remote host has')
    remote_harnesses.add_argument('server', help='SSH config alias or user@host')
    remote_harnesses.add_argument('--json', action='store_true',
                                  help='write JSON instead of rows')

    return parser.parse_args(argv)


def main(argv: list[str]) -> int:
    args = parse_args(argv)

    if args.action == 'live':
        root = pathlib.Path(args.sessions_dir).expanduser()
        entries = live_sessions(root)
        if args.json:
            json.dump(entries, sys.stdout, indent=2)
            sys.stdout.write('\n')
        else:
            for entry in entries:
                kind = 'certain' if entry['certain'] else 'probable'
                owner = entry['owner'] or 'host unknown'
                print(f'{entry["id"]}\t{entry["written"]}s\t{entry["pids"]}\t{kind}\t'
                      f'{owner}\t{entry["cwd"]}\t{live_state_column(entry)}')
        return 0

    if args.action == 'state':
        entries = live_states(pathlib.Path(args.live_dir).expanduser())
        if args.json:
            json.dump(entries, sys.stdout, indent=2)
            sys.stdout.write('\n')
        else:
            for entry in entries:
                print(f'{entry["id"]}\t{live_state_column(entry)}\t{entry["detail"]}\t{entry["age"]}s')
        return 0

    if args.action == 'focus':
        return focus_session(args.session, args.emit_cmd, args.target)

    if args.action == 'zmx-connect':
        return zmx_connect(args.server, args.check, not args.no_wait, args.restart)

    if args.action == 'zmx-remote-list':
        try:
            entries = zmx_remote_sessions(args.server)
        except subprocess.TimeoutExpired:
            return fail(f'sh2pil-open: remote zmx list on {args.server} timed out')
        except (OSError, RuntimeError, ValueError) as error:
            return fail(f'sh2pil-open: could not list zmx sessions on {args.server}: {error}')
        if args.json:
            json.dump(entries, sys.stdout, indent=2)
            sys.stdout.write('\n')
        else:
            for entry in entries:
                state = 'attached' if entry['clients'] else 'detached'
                print(f"{entry['name']}\t{state}\t{entry['created']}\t{entry['cwd']}")
        return 0

    if args.action == 'zmx-remote-projects':
        try:
            paths = zmx_remote_projects(args.server)
        except (OSError, subprocess.TimeoutExpired, RuntimeError, ValueError) as error:
            return fail(f'sh2pil-open: could not list zoxide projects on {args.server}: {error}')
        if args.json:
            json.dump(paths, sys.stdout, indent=2)
            sys.stdout.write('\n')
        else:
            for path in paths:
                print(path)
        return 0

    if args.action == 'zmx-list':
        entries = zmx_sessions()
        if args.json:
            json.dump(entries, sys.stdout, indent=2)
            sys.stdout.write('\n')
        else:
            for entry in entries:
                state = 'attached' if entry['clients'] else 'detached'
                print(f'{entry["name"]}\t{state}\t{entry["created"]}\t{entry["cwd"]}\t'
                      f'{entry["chat"]}')
        return 0

    if args.action == 'zmx-switch':
        return zmx_switch(args.name, args.cwd, args.place, args.emit_cmd, args.server)

    if args.action == 'zmx-remote-new':
        return zmx_remote_new(args.server, args.cwd, args.place, args.emit_cmd)

    if args.action == 'zmx-history':
        return zmx_history(args.name, args.lines)

    if args.action == 'zmx-kill':
        return zmx_kill(args.name, args.server)

    if args.action == 'zmx-copy':
        return zmx_copy(args.name, args.server)

    if args.action == 'session-remote-list':
        try:
            rows = session_remote_list(args.server, args.harness, args.live)
        except subprocess.TimeoutExpired:
            return fail(f'sh2pil-open: listing sessions on {args.server} timed out')
        except (OSError, RuntimeError, ValueError) as error:
            return fail(f'sh2pil-open: could not list sessions on {args.server}: {error}')
        if args.json:
            json.dump(rows, sys.stdout, indent=2)
            sys.stdout.write('\n')
        else:
            for row in rows:
                state = 'live' if row.get('live') else 'gone' if not row.get('alive') else ''
                print(f"{row.get('id', '')}\t{row.get('modified', 0)}\t{state}\t"
                      f"{row.get('name', '')}\t{row.get('project', '')}\t{row.get('file', '')}")
        return 0

    if args.action == 'state-remote':
        try:
            entries = state_remote(args.server)
        except subprocess.TimeoutExpired:
            return fail(f'sh2pil-open: asking {args.server} what its chats are doing timed out')
        except (OSError, RuntimeError, ValueError) as error:
            return fail(f'sh2pil-open: could not ask {args.server} what its chats are doing: '
                        f'{error}')
        if args.json:
            json.dump(entries, sys.stdout, indent=2)
            sys.stdout.write('\n')
        else:
            for entry in entries:
                print(f'{entry["id"]}\t{live_state_column(entry)}\t{entry.get("detail", "")}\t'
                      f'{entry.get("age", 0)}s')
        return 0

    if args.action == 'harnesses-remote':
        try:
            stores = harnesses_remote(args.server)
        except subprocess.TimeoutExpired:
            return fail(f'sh2pil-open: asking {args.server} for its session stores timed out')
        except (OSError, RuntimeError, ValueError) as error:
            return fail(f'sh2pil-open: could not ask {args.server} for its session stores: {error}')
        if args.json:
            json.dump(stores, sys.stdout, indent=2)
            sys.stdout.write('\n')
        else:
            for store in stores:
                mark = 'present' if store.get('present') else 'absent'
                line = f"{store.get('harness', ''):<9} {mark}"
                if store.get('reason'):
                    line += f"  ({store['reason']})"
                print(line)
        return 0

    if args.action == 'session-remote-show':
        try:
            text = session_remote_show(args.server, args.session, args.harness, args.tail,
                                       args.file)
        except subprocess.TimeoutExpired:
            return fail(f'sh2pil-open: reading {args.session} on {args.server} timed out')
        except (OSError, RuntimeError, ValueError) as error:
            return fail(f'sh2pil-open: could not read {args.session} on {args.server}: {error}')
        sys.stdout.write(text)
        return 0

    if args.action == 'session-remote-file':
        try:
            data = session_remote_file(args.server, args.file)
        except subprocess.TimeoutExpired:
            return fail(f'sh2pil-open: reading {args.file} on {args.server} timed out')
        except (OSError, RuntimeError, ValueError) as error:
            return fail(f'sh2pil-open: could not read {args.file} on {args.server}: {error}')
        write_bytes(data)
        return 0

    if args.action == 'session-remote-open':
        return session_remote_open(args.server, args.cwd, args.session, args.harness,
                                   args.fork, args.name, args.label, args.place,
                                   args.emit_cmd)

    if args.action == 'session-remote-copy':
        return session_remote_copy(args.server, args.session, args.harness, args.cwd)

    if args.action == 'run-tool':
        return run_tool(args.cwd, args.command, args.label, args.place, args.emit_cmd)

    if args.action == 'tool-remote':
        return tool_remote(args.server, args.cwd, args.tool, args.label, args.place,
                           args.emit_cmd)

    if args.action == 'shell-remote':
        return shell_remote(args.server, args.cwd, args.label, args.place, args.emit_cmd)

    if args.action == 'editor-remote':
        return editor_remote(args.server, args.cwd, args.editor, args.label, args.place,
                             args.emit_cmd)

    if args.action == 'paste-remote':
        return paste_remote(args.server, args.emit_cmd)

    if args.action == 'window-target':
        identifier = args.window or os.environ.get('KITTY_WINDOW_ID', '')
        if not identifier:
            return fail('sh2pil-open: window-target needs --window, or a kitty window to run in')
        return print_window_target(identifier, args.json)

    if args.action == 'window-session':
        identifier = args.window or os.environ.get('KITTY_WINDOW_ID', '')
        if not identifier:
            return fail('sh2pil-open: window-session needs --window, or a kitty window to run in')
        return print_window_session(identifier, args.harness, args.json)

    if args.action == 'window-menu':
        identifier = args.window or os.environ.get('KITTY_WINDOW_ID', '')
        if not identifier:
            return fail('sh2pil-open: window-menu needs --window, or a kitty window to run in')
        return window_menu(identifier, args.emit_cmd)

    if args.action == 'paste-window':
        identifier = args.window or os.environ.get('KITTY_WINDOW_ID', '')
        if not identifier:
            return fail('sh2pil-open: paste-window needs --window, or a kitty window to run in')
        return paste_window(identifier)

    if args.action == 'session-remote-delete':
        try:
            return session_remote_delete(args.server, args.session, args.harness, args.force)
        except subprocess.TimeoutExpired:
            return fail(f'sh2pil-open: deleting {args.session} on {args.server} timed out')
        except (OSError, RuntimeError, ValueError) as error:
            return fail(f'sh2pil-open: could not delete {args.session} on {args.server}: {error}')

    if args.action == 'session-remote-prune':
        arguments = ['--older-than', args.older_than, '--harness', args.harness, '--json']
        if args.zmx:
            arguments.append('--zmx')
        if args.yes:
            arguments.append('--yes')
        if args.force:
            arguments.append('--force')
        try:
            return session_remote_prune(args.server, arguments)
        except subprocess.TimeoutExpired:
            return fail(f'sh2pil-open: pruning {args.server} timed out')
        except (OSError, RuntimeError, ValueError) as error:
            return fail(f'sh2pil-open: could not prune {args.server}: {error}')

    if args.action == 'retitle':
        return retitle_session(args.session, args.name, args.emit_cmd)

    if args.action == 'editor':
        command = [sys.executable, str(sh2pil_last()), '--session',
                   str(pathlib.Path(args.transcript).expanduser()), '--full',
                   '--nvim', args.editor]
        if args.emit_cmd:
            print(shlex.join(command))
            return 0
        if not sys.stdin.isatty():
            print(shlex.join(command))
            return 0
        return subprocess.run(command, check=False).returncode

    if args.action == 'switch':
        entry = live_entry(args.session)
        if entry is not None:
            window, reason, choices = owner_window(entry)
            if window is not None:
                if not args.emit_cmd:
                    print(f'sh2pil-open: switching to {window["label"]} because {reason}',
                          file=sys.stderr)
                return focus_window(window, args.emit_cmd)
            # No terminal shows it.  A zmx session can be attached from anywhere, so attach
            # to it rather than resume: a resume would add a second writer to the transcript.
            if zmx_session_name(entry['id']):
                return open_terminal('attach', args)
            print('sh2pil-open: no unique terminal for this running session; a resume '
                  'would add a second writer to the transcript', file=sys.stderr)
        # Nothing running, or nowhere reachable: behave like `pi`, which asks when unsure.
        return open_terminal('pi', args)

    return open_terminal(args.action, args)


# focus_session brings the terminal that runs a session forward.  Exit 1 means nothing is
# running and exit 2 means it runs somewhere this cannot reach: the caller resumes in both
# cases, and asks first when a second writer is possible.
def retitle_session(identifier: str, name: str, emit: bool = False) -> int:
    """Give the terminal that runs a session the session's name.

    A rename writes the transcript, and the pi process that owns the session never notices:
    it keeps the name it read at startup and would rewrite its own title from that.  Setting
    the tab and window titles now keeps the tab bar in step with the store until that process
    exits.  Exit 1 means nothing is running, 2 means no reachable terminal.
    """
    entry = live_entry(identifier)
    if entry is None:
        print('sh2pil-open: nothing is running that session', file=sys.stderr)
        return 1
    title = name or squeeze(str(entry.get('name') or ''))
    if not title:
        return fail('sh2pil-open: no name to set on the terminal')
    window, reason, choices = owner_window(entry)
    if window is None:
        if choices:
            return fail(f'sh2pil-open: {choices} terminals hold a pi in that project, none matched')
        pids = ', '.join(str(pid) for pid in entry['pids'])
        print(f'sh2pil-open: pi pid {pids} runs {entry["cwd"]}, on a host this cannot reach',
              file=sys.stderr)
        return 2

    if window['medium'] == 'kitty':
        # A pane is a window in kitty's words, so the window gets the title and the tab is
        # matched through the window it contains.
        commands = [
            window['prefix'] + ['set-window-title', '--match', f'id:{window["target"]}', title],
            window['prefix'] + ['set-tab-title', '--match',
                                f'window_id:{window["target"]}', title],
        ]
    elif window['medium'] == 'tmux':
        commands = [['tmux', 'rename-window', '-t', window['target'], title]]
    else:
        return 2

    for command in commands:
        if emit:
            print(shlex.join(command))
            continue
        result = subprocess.run(command, capture_output=True)
        if result.returncode != 0:
            return fail('sh2pil-open: could not retitle: '
                        + result.stderr.decode('utf-8', 'replace').strip())
    if not emit:
        print(f'sh2pil-open: {window["label"]} is now titled {title!r} because {reason}',
              file=sys.stderr)
    return 0


def focus_session(identifier: str, emit: bool = False, target: str = '') -> int:
    entry = live_entry(identifier)
    if entry is None:
        print('sh2pil-open: nothing is running that session', file=sys.stderr)
        return 1
    window, reason, choices = owner_window(entry, target)
    if window is None:
        pids = ', '.join(str(pid) for pid in entry['pids'])
        if choices:
            return fail(f'sh2pil-open: {choices} terminals hold this pi process; '
                        f'no unique terminal matched {target or "the session"}')
        print(f'sh2pil-open: pi pid {pids} runs {entry["cwd"]}, on a host this cannot reach',
              file=sys.stderr)
        return 2
    if not emit:
        print(f'sh2pil-open: switching to {window["label"]} because {reason}',
              file=sys.stderr)
    return focus_window(window, emit)


def open_terminal(action: str, args: argparse.Namespace) -> int:
    """Open a terminal for a Pi, OpenCode, or Claude Code chat, shell, lazygit, or yazi."""
    cwd = str(pathlib.Path(args.cwd).expanduser())
    if action == 'attach':
        # Attach to the zmx session that runs this chat.  The session's own directory and
        # size are already its own, so only the client is started here.
        binary = zmx_binary()
        if not binary:
            return fail('sh2pil-open: zmx is not installed, so there is no session to attach to')
        name = zmx_session_name(args.session)
        if not name:
            return fail(f'sh2pil-open: no zmx session carries {args.session}')
        return launch(zmx_client_argv(name, binary), cwd, '',
                      zmx_client_place(args.place), args.emit_cmd)
    if action == 'pi':
        fork = getattr(args, 'fork', False)
        force = getattr(args, 'force', False)
        # `switch` is a resume and has no --name, which is why every read of it is defensive:
        # the same code serves `pi`, `pi --fork`, and `switch`, and only the first two can
        # carry a name.
        name = getattr(args, 'name', '')
        with_flag = '--fork' if fork else '--session'
        argv_tool = ['pi', with_flag, args.session]
        if name and not fork:
            # A resumed session already has a name; naming it here would rename it instead.
            return fail('sh2pil-open: --name applies to --fork, not to a resume')
        if fork and name:
            argv_tool += ['--name', name]
        # A fork is a different session, so its own name belongs in the window name a
        # terminal server would use: the caller's label describes the session that was
        # picked, which is the one being left.  kitty drops this later (above), where pi
        # names the window itself.
        label = args.label or f'pi {short_name(args.session)}'
        if fork and name:
            label = f'pi {name}'
        if not fork and not force and not args.emit_cmd:
            # A resume writes into an existing transcript; a fork writes a new one.
            entry = live_entry(args.session)
            if entry is not None and warn_live(entry):
                return 1
            if entry is None and warn_untracked(cwd):
                return 1
    elif action == 'opencode':
        argv_tool = ['opencode', '--session', args.session]
        label = args.label or f'opencode {short_name(args.session)}'
    elif action == 'opencode-new':
        argv_tool = ['opencode']
        label = args.label or f'opencode {os.path.basename(cwd)}'
    elif action == 'claude':
        # Claude Code resumes a session id or a transcript path, and a fork is the same
        # command with a session id of its own.  Its own store holds no process record to
        # ask, so a resume here never asks about a second writer.
        argv_tool = ['claude', '--resume', args.session]
        if getattr(args, 'fork', False):
            argv_tool.append('--fork-session')
            name = getattr(args, 'name', '')
            if name:
                argv_tool += ['--name', name]
        label = args.label or f'claude {short_name(args.session)}'
    elif action == 'claude-new':
        argv_tool = ['claude']
        label = args.label or f'claude {os.path.basename(cwd)}'
    elif action == 'codex':
        # Codex resumes a session id from any directory, and `codex fork` copies the
        # conversation under a session id of its own.  Its store keeps no process-to-session
        # record, so a resume here never asks about a second writer.
        argv_tool = ['codex', 'fork' if getattr(args, 'fork', False) else 'resume',
                     args.session]
        if getattr(args, 'fork', False) and getattr(args, 'name', ''):
            # Codex names a fork itself; there is no flag to carry a name of ours.
            print('sh2pil-open: Codex names a fork itself; the given name is not used',
                  file=sys.stderr)
        label = args.label or f'codex {short_name(args.session)}'
    elif action == 'codex-new':
        argv_tool = ['codex']
        label = args.label or f'codex {os.path.basename(cwd)}'
    elif action == 'new':
        # No transcript is reused, so there is no question about a second writer and no name
        # to reuse.  The label stays empty unless the caller asked for one: pi titles its own
        # window from the session name it generates, and a title set here would sit in the tab
        # bar as a stale copy of that name.
        argv_tool = ['pi']
        label = args.label
    elif action == 'lazygit':
        argv_tool = ['lazygit']
        label = args.label or f'lazygit {os.path.basename(cwd)}'
    elif action == 'yazi':
        # yazi browses the directory it starts in; the caller passes the project directory
        # itself, while lazygit alone climbs to the repository top.
        argv_tool = ['yazi']
        label = args.label or f'yazi {os.path.basename(cwd)}'
    elif action == 'editor-dir':
        if not os.path.isdir(cwd):
            return fail(f'sh2pil-open: {cwd} is not a directory')
        argv_tool = shlex.split(args.editor)
        if not argv_tool:
            return fail('sh2pil-open: editor command is empty')
        argv_tool.append(cwd)
        label = args.label or f'nvim {os.path.basename(cwd)}'
    else:
        argv_tool = []
        label = args.label or f'shell {os.path.basename(cwd)}'

    if cwd and not os.path.isdir(cwd):
        if action in ('pi', 'claude', 'codex'):
            # A recorded project directory can be gone (188 of 427 sessions on
            # 2026-09-25, 202 of 435 on 2026-09-26).  A Pi session resumes from a transcript
            # path and a Claude Code or Codex one resumes from its id from any directory, so
            # all of them start in $HOME instead of refusing.  The caller decides whether to
            # pass the id or the path.
            print(f'sh2pil-open: {cwd} is gone; starting in $HOME instead', file=sys.stderr)
            cwd = str(pathlib.Path.home())
        else:
            return fail(f'sh2pil-open: {cwd} does not exist')

    # A chat is worth keeping alive across terminals; a shell, lazygit, yazi, or an editor
    # is not.
    # The flag is off unless the shared config turns it on, and a machine without zmx keeps
    # the plain terminal instead of opening a window that would fail at once.
    binary = zmx_binary() if config_flag('zmx') else ''
    if binary and action in ZMX_ACTIONS:
        args.place = zmx_client_place(args.place)
        argv_tool = zmx_attach_argv(argv_tool, cwd, getattr(args, 'session', ''), binary)

    # Pi names its own window, as `π - <session name> - <project>`, and kitty's
    # --title/--tab-title pin a title so that a later change by the program never lands: a
    # resumed chat would keep showing the short session id instead of the name.  A shell,
    # lazygit, or yazi has no name of its own, so the label is still worth pinning there.
    if action == 'pi':
        label = ''

    return launch(argv_tool, cwd, label, args.place, args.emit_cmd)


if __name__ == '__main__':
    try:
        code = main(sys.argv[1:])
    except BrokenPipeError:
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        code = 0
    except KeyboardInterrupt:
        code = 130
    except Exception:
        note_crash()
        code = 1
    sys.exit(code)
