try:
    import pwd
except ImportError:  # only POSIX has a passwd database
    pwd = None


def login_shell() -> str:
    """Return the shell that runs a tool command and opens a new window.

    The reader's own shell is the right answer for both: a new window should be the shell
    they chose, and the tool commands must be run by the shell whose rc file puts the
    Homebrew directory, the agent socket, and the rest of their environment in place.

    `$SHELL` first, because a terminal exports it; then the passwd entry, which is the
    machine's own answer; then bash and sh.  A candidate that is not installed is skipped
    rather than named, so a machine with no zsh opens bash, and nothing here requires a
    particular shell to be present.
    """
    candidates = [os.environ.get('SHELL')]
    if pwd is not None:
        try:
            candidates.append(pwd.getpwuid(os.getuid()).pw_shell)
        except (KeyError, OSError):
            pass
    candidates += ['/bin/bash', '/usr/bin/bash', '/bin/sh']
    for candidate in candidates:
        if candidate and os.access(candidate, os.X_OK):
            return candidate
    return 'sh'


SHELL = login_shell()
DEFAULT_EDITOR = 'nvim'

